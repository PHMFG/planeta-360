{
  "modelo": "ATIVACAO_EVENTO",
  "versao": 1,
  "aba": "APLICACOES",
  "titulo": "Ativação no evento",
  "secoes": [
    { "id": "capa", "blocos": [
      { "id": "b-capa", "tipo": "capa", "titulo": "Ativação no evento",
        "subtitulo": { "ref": "parc:patrocinador" }, "edicao": { "ref": "evento:edicao" } } ] },
    { "id": "resumo", "titulo": "Resumo", "blocos": [
      { "id": "b-resumo", "tipo": "paragrafo", "redigivel": true,
        "frase_modelo": "A marca {{parc:patrocinador}} teve {{cons:aplicacoes.comprovadas}} de {{cons:aplicacoes.previstas}} aplicações de marca comprovadas no evento." } ] },
    { "id": "aplicacoes", "titulo": "Aplicações de marca", "blocos": [
      { "id": "b-kpi-aplic", "tipo": "kpi_grade", "itens": [
        { "rotulo": "Previstas",   "valor": { "ref": "cons:aplicacoes.previstas" } },
        { "rotulo": "Comprovadas", "valor": { "ref": "cons:aplicacoes.comprovadas" } },
        { "rotulo": "Comprovação", "valor": { "ref": "cons:aplicacoes.percentual" } },
        { "rotulo": "Fotos",       "valor": { "ref": "cons:aplicacoes.fotos" } } ] },
      { "id": "b-tab-aplic", "tipo": "tabela", "fonte": { "ref": "lista:aplicacoes" } } ] },
    { "id": "publico", "titulo": "Público e engajamento", "blocos": [
      { "id": "b-kpi-publico", "tipo": "kpi_grade", "itens": [
        { "rotulo": "Visitantes",            "valor": { "ref": "dado:ativacao.visitantes_total" } },
        { "rotulo": "Cadastros",             "valor": { "ref": "dado:ativacao.cadastros_consentidos" } },
        { "rotulo": "Taxa de cadastro",      "valor": { "ref": "calc:taxa_cadastro" } },
        { "rotulo": "Brindes distribuídos",  "valor": { "ref": "calc:brindes_pct" } } ] },
      { "id": "b-publico", "tipo": "paragrafo", "redigivel": true,
        "frase_modelo": "O espaço recebeu {{dado:ativacao.visitantes_total}} visitantes, e {{calc:taxa_cadastro}} deles deixaram cadastro com consentimento." } ] },
    { "id": "comprovacoes", "titulo": "Comprovações", "blocos": [
      { "id": "b-galeria", "tipo": "galeria_comprovacoes", "fonte": { "ref": "lista:comprovacoes" } } ] },
    { "id": "fontes", "titulo": "Fontes e cálculos", "blocos": [
      { "id": "b-fontes", "tipo": "fontes" } ] }
  ],
  "calculos": {
    "taxa_cadastro": { "rotulo": "Taxa de cadastro", "unidade": "%", "script": "pct(cadastros, visitantes)",
      "variaveis": { "cadastros":  { "ref": "dado:ativacao.cadastros_consentidos" },
                     "visitantes": { "ref": "dado:ativacao.visitantes_total" } } },
    "brindes_pct": { "rotulo": "Brindes distribuídos", "unidade": "%", "script": "pct(distribuidos, disponiveis)",
      "variaveis": { "distribuidos": { "ref": "dado:ativacao.brindes_distribuidos" },
                     "disponiveis":  { "ref": "dado:ativacao.brindes_disponiveis" } } }
  },
  "lacunas": {
    "obrigatorias": ["ativacao.visitantes_total", "ativacao.cadastros_consentidos"],
    "opcionais": ["ativacao.brindes_disponiveis", "ativacao.brindes_distribuidos"]
  }
}
